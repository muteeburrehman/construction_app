# ==============================================================================
# Apex Construction Group — Environment Configuration (.env)
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-this-to-a-secure-random-string-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev

# Allowed Hosts & Security
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (PostgreSQL 16)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://construction_user:construction_secret@localhost:5432/construction_db

# Email / Notifications (Inquiries)
DEFAULT_FROM_EMAIL=contact@construction.muteeblabs.com
INQUIRY_NOTIFICATION_EMAIL=contact@construction.muteeblabs.com
